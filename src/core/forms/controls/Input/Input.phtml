<?php /** @var \core\forms\controls\Input\Input $this */

?>
<?php $id = $this->getId() ?>
<div class="form-control <?= $this->cssClass ?>">
    <?php if (!is_null($this->label)): ?>
        <label for="<?= $id ?>"><?= $this->label ?></label>
    <?php endif; ?>
    <input
        type="<?= $this->type ?>"
        value="<?= $this->value ?>"
        name="<?= $this->name ?>"
        id="<?= $id ?>"
        <?= $this->stringifyAttributes() ?>
    >
</div>
