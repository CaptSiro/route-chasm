<?php /** @var \core\forms\controls\Checkbox\Checkbox $this */?>
<?php $id = $this->getId() ?>
<label class="checkbox-container <?= $this->cssClass ?>" for="<?= $id ?>">
    <input
        type="checkbox"
        checked="<?= $this->value ?>"
        name="<?= $this->name ?>"
        id="<?= $id ?>"
        <?= $this->stringifyAttributes() ?>
    >
    <span><?= $this->label ?></span>
</label>
